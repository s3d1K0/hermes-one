// Copier en OneSecrets.swift (gitignore) et remplacer par ta vraie cle
// Gemini Live, obtenue sur https://aistudio.google.com/apikey, et les
// coordonnees du gateway Hermes (push proactif, OpenClaw) si utilise.
import Foundation

enum OneSecrets {
    static let geminiAPIKey = "YOUR_GEMINI_API_KEY"

    // Push proactif (canal d'evenements du gateway Hermes / OpenClaw).
    static let gatewayHost = "http://YOUR_MAC_HOSTNAME.local"
    static let gatewayPort = 18789
    static let gatewayToken = "YOUR_OPENCLAW_GATEWAY_TOKEN"
}
